# Copy to .env. Keys stay on the server: never commit .env.
OPENAI_API_KEY=
# The database from docker-compose.yml.
DATABASE_URL=postgres://postgres:ask-oncall@127.0.0.1:55434/ask_oncall
# Every OpenAI call is priced into .cache/ledger.jsonl; a step that would take
# the total past this many dollars refuses to start.
BUDGET_USD=5
